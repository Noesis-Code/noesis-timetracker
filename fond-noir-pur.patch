+  // 17 septembre 2026 (discussion "Objectifs — Titres des catégories"),
+  // demande d'Emilien : badge de catégorie sans remplissage — fond
+  // transparent, texte et liseré dans la couleur de la catégorie (voir
+  // renderGoalsGridHead() plus bas). Sans fond rempli, la nuance n'a plus
+  // aucun contraste automatique avec ce qu'il y a derrière (contrairement à
+  // avant, où readableTextOn() ci-dessus choisissait le texte en fonction du
+  // FOND rempli) : une nuance trop sombre en thème sombre, ou trop claire en
+  // thème clair, devient difficile à lire en petit texte. Les 5 nuances de
+  // subProjectShade() couvrent volontairement L* 22 à 90 (voir son
+  // commentaire plus bas) pour rester distinguables ENTRE ELLES — ça ne
+  // suffit pas à garantir une bonne lisibilité en TEXTE. Corrige seulement
+  // au-delà du même seuil L* 56 que readableTextOn() (mi-bande), et mélange
+  // proportionnellement vers le blanc (thème sombre) ou le noir (thème
+  // clair) — jusqu'à 60 % à l'extrême de la bande, jamais 100 % : la teinte
+  // d'origine reste identifiable, seule la clarté est corrigée.
+  function eclairciPourLisibilite(hex) {
+    var L = labLightness(hex);
+    var seuil = 56;
+    var vers, ecart;
+    if (currentTheme === 'light') {
+      if (L <= seuil) return hex;
+      vers = '#000000';
+      ecart = Math.min((L - seuil) / (100 - seuil), 1);
+    } else {
+      if (L >= seuil) return hex;
+      vers = '#ffffff';
+      ecart = Math.min((seuil - L) / seuil, 1);
+    }
+    var amount = ecart * 0.6;
+    var r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
+    var r2 = parseInt(vers.slice(1, 3), 16), g2 = parseInt(vers.slice(3, 5), 16), b2 = parseInt(vers.slice(5, 7), 16);
+    r = Math.round(r + (r2 - r) * amount);
+    g = Math.round(g + (g2 - g) * amount);
+    b = Math.round(b + (b2 - b) * amount);
+    return '#' + [r, g, b].map(function (v) { return v.toString(16).padStart(2, '0'); }).join('');
+  }
+
   // ⚠️ 6 septembre 2026, demande d'Emilien : « je souhaite que tu crées pour
   // chaque couleur d'activité 5 nuances distinguables à l'œil nu ».
   //
