{
  "name": "Noèsis — TimeTracker",
  "short_name": "Noèsis",
  "description": "Chrono, statistiques et communauté : suis le temps que tu passes sur tes activités, seul ou avec les personnes qui les partagent.",
  "lang": "fr",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
